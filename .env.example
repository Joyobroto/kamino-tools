# Copy to .env. Never commit a real keypair or secret.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional failover endpoint (keyless public RPCs work, e.g. https://pump.helius-rpc.com).
# On 429s or connection failures the transport flips here for 2 minutes and
# retries the same request — the pipeline never starves on one provider's quota.
SOLANA_RPC_FALLBACK=
KAMINO_MARKET=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF

# Recommended signer source. Supports base58 or a JSON array containing 32/64 bytes.
PRIVATE_KEY=

# Optional fallback: local Solana 64-byte JSON keypair. Paths beginning with ~/ are supported.
KEYPAIR_PATH=~/.config/solana/id.json

# Telegram alerts for the watcher (optional — leave empty to disable).
# Create a bot via @BotFather, get the token, then chat with the bot and get your
# chat id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

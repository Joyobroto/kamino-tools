# Copy to .env. Never commit a real keypair or secret.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional failover endpoint (keyless public RPCs work, e.g. https://pump.helius-rpc.com).
# On 429s or connection failures the transport flips here for 2 minutes and
# retries the same request — the pipeline never starves on one provider's quota.
SOLANA_RPC_FALLBACK=
KAMINO_MARKET=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF

# Recommended signer source. Supports base58 or a JSON array containing 32/64 bytes.
PRIVATE_KEY=

# Optional fallback: local Solana 64-byte JSON keypair. Paths beginning with ~/ are supported.
KEYPAIR_PATH=~/.config/solana/id.json

# Telegram alerts for the watcher (optional — leave empty to disable).
# Create a bot via @BotFather, get the token, then chat with the bot and get your
# chat id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Helius Sender: EXECUTION-ONLY broadcast lane ──────────────────────────
# https://www.helius.dev/docs/sending-transactions/sender
# Only the liquidation broadcast goes through Sender; price/oracle/screening and
# confirmation stay on SOLANA_RPC_URL. Sender consumes no API credits — you pay a
# per-tx SOL tip. SWQOS-only (min 0.000005 SOL) is used for small prizes, Sender
# Max (min 0.001 SOL, all pathways + priority tip buffer) for prizes >= the
# threshold. The executor refuses to fire when the prize does not cover the lane
# cost (tip + priority fee + base fee + min-profit).
#
# Regional endpoints (backend): use the one closest to the host.
#   http://ewr-sender.helius-rpc.com/fast   # Newark
#   http://slc-sender.helius-rpc.com/fast   # Salt Lake City
#   http://lon-sender.helius-rpc.com/fast   # London
#   http://fra-sender.helius-rpc.com/fast   # Frankfurt
#   http://ams-sender.helius-rpc.com/fast   # Amsterdam
#   http://sg-sender.helius-rpc.com/fast    # Singapore
#   http://tyo-sender.helius-rpc.com/fast   # Tokyo
HELIUS_SENDER_ENDPOINT=http://ewr-sender.helius-rpc.com/fast
# Set to false to broadcast directly on SOLANA_RPC_URL instead.
LIQ_SENDER_ENABLED=true
# Prize (worst-case profit USD) at/above which Sender Max is used; below it SWQOS-only.
LIQ_SENDER_MAX_PRIZE_USD=5
# Never tip more than this fraction of the prize, and never more than the SOL cap.
LIQ_SENDER_MAX_TIP_FRACTION=0.01
LIQ_SENDER_MAX_TIP_CAP_SOL=0.02
# Submit Sender Max fires as an atomic bundle routed through Jito + all pathways.
# Helius adds the Jito/pathway tips itself — do NOT add a separate Jito tip.
LIQ_SENDER_BUNDLE=true
# Required worst-case net profit AFTER lane cost (defaults to --min-profit).
LIQ_SENDER_MIN_PROFIT_USD=0.05

